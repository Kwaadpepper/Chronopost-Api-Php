includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:

    paths:
        - src/
        - tests/

    # Level 9 is the highest level
    level: 6

    ignoreErrors:
        # assertInstanceOf is intentional in tests even when PHPStan can infer the type
        -
            identifier: staticMethod.alreadyNarrowedType
            path: tests/*

        # assertNull / assertCount on known types is intentional in tests
        -
            identifier: method.alreadyNarrowedType
            path: tests/*

        # method_exists on known classes is intentional in architecture tests
        -
            identifier: function.alreadyNarrowedType
            path: tests/*
